# Graph Memory — 环境变量配置示例
# 复制此文件为 .env 并修改,app 启动时自动加载

# LLM 配置(用于知识提炼 /api/refine,可选)
# 支持 OpenAI 兼容 API (如 DeepSeek、GLM、Qwen、OpenAI 等)
GM_LLM_API_KEY=sk-your-key
GM_LLM_BASE_URL=https://api.deepseek.com/v1
GM_LLM_MODEL=deepseek-chat

# 数据目录(可选,默认 ~/.graph-memory)
# GM_DATA_DIR=/path/to/custom/data
